# Reference only. Export these in your shell or configure your IDE.
# Spring Boot does not automatically load this file.
# Replace the entire URL with the instructor-provided final JDBC URL, including TLS settings.
# Example mapping only: student01 -> wms01. Do not use before external access is announced.
SPRING_DATASOURCE_URL=jdbc:postgresql://REPLACE_WITH_DB_HOST:5432/REPLACE_WITH_STUDENT_DATABASE?currentSchema=wms&sslmode=require
SPRING_DATASOURCE_USERNAME=REPLACE_WITH_STUDENT_USER
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD

# PostgreSQL MCP (@microsoft/postgres-mcp) / apply_from_env.py — .env 에만 설정, 커밋 금지
# libpq URI (비밀번호 포함). Host·DB·계정은 docs/00.guide/DB-CONNECT.md
# WMS_PG_CONNECTION_STRING=postgresql://student01:YOUR_PASSWORD@REPLACE_HOST:5432/wms01?sslmode=require
